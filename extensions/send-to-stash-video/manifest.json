{
  "manifest_version": 3,
  "name": "Send to Stash Video",
  "version": "1.0.0",
  "description": "Send the current page to Stash Video for analysis and download.",
  "permissions": ["activeTab"],
  "action": { "default_title": "Send to Stash Video" },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "browser_specific_settings": {
    "gecko": { "id": "send-to-stash-video@ayala.solutions", "strict_min_version": "121.0" }
  }
}
